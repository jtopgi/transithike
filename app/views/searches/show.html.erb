<% label = coordinates && @origin == SearchesController::CURRENT_LOCATION ? "your location" : @origin %>
<% content_for :title, @error ? "Day hikes by train" : "Day hikes by train from #{label}" %>
<%# Results load as they're found, which search engines can't follow, and every starting point has its own. %>
<% content_for :robots, "noindex" %>
<section class="results-hero text-white">
  <div class="container py-4">
    <div class="row g-4 align-items-center">
      <div class="col-lg-6">
        <% if @error %>
          <h1 class="h2 fw-bold mb-0">Day hikes by train</h1>
        <% else %>
          <h1 class="h2 fw-bold mb-1" data-heading>Day hikes by train from <%= label %></h1>
          <p class="mb-0 results-subtitle" data-departure>
            Weekend day trips by train, with a way back the same evening.
          </p>
          <p class="mb-0 mt-2 results-stations small" data-stations hidden></p>
          <%# On phones, the search box opens from here, so the hikes come first. The page shows the button. %>
          <button type="button" class="btn btn-light btn-sm mt-3 d-lg-none" aria-controls="change-search" aria-expanded="true"
                  data-search-toggle hidden><span aria-hidden="true">✏️</span> Change search</button>
        <% end %>
      </div>
      <div class="col-lg-6 results-search" id="change-search">
        <div class="card search-card border-0 shadow">
          <div class="card-body p-3">
            <%= render "search_box", origin: @origin %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<% unless @error
     stream_url = search_stream_path({ origin: @origin, lat: coordinates&.first, lon: coordinates&.last,
       day: requested_day, tz: requested_time_zone }.compact)
   end %>
<%= tag.div class: "container py-4", data: { stream_url: stream_url } do %>
  <% if @error %>
    <div class="alert alert-danger" role="alert"><%= @error %></div>
  <% else %>
    <noscript><div class="alert alert-warning">TransitHike needs JavaScript to find hikes.</div></noscript>
    <div class="alert alert-danger" role="alert" data-failure hidden></div>
    <div class="search-progress mb-4" data-progress role="status" aria-live="polite">
      <span class="spinner-border spinner-border-sm text-success" aria-hidden="true"></span>
      <span data-progress-text>Finding the stations trains reach and the hikes near them…</span>
    </div>
    <div class="results-toolbar d-flex flex-wrap align-items-center gap-3 gap-lg-4 mb-4" data-results-toolbar hidden>
      <%# At its right end, the round-trip slider allows any round trip. %>
      <div class="toolbar-range">
        <label for="round-trip" class="small fw-semibold">
          Round trip: <span class="fw-normal" data-max-trip-label>any</span>
        </label>
        <input type="range" id="round-trip" class="form-range range-fill" min="120" max="480" step="15" value="480" data-max-trip>
      </div>
      <%# At their ends, the length slider's handles allow any length. %>
      <div class="toolbar-range" role="group" aria-labelledby="length-range-label">
        <span id="length-range-label" class="small fw-semibold">Length: <span class="fw-normal" data-length-label>any</span></span>
        <div class="range-dual" data-length-range>
          <input type="range" class="form-range" min="1" max="20" step="0.5" value="1" aria-label="Shortest length, in miles"
                 data-length-min>
          <input type="range" class="form-range" min="1" max="20" step="0.5" value="20" aria-label="Longest length, in miles"
                 data-length-max>
        </div>
      </div>
      <span class="small text-body-secondary ms-lg-auto" data-results-count aria-live="polite"></span>
    </div>
    <div class="row row-cols-1 row-cols-md-2 g-4" data-trails>
      <% 2.times do %>
        <div class="col" data-skeleton aria-hidden="true">
          <div class="card trail-card trail-skeleton h-100 border-0 shadow-sm">
            <div class="trail-media"></div>
            <div class="card-body p-4">
              <div class="skeleton-line w-75"></div>
              <div class="skeleton-line w-50"></div>
              <div class="skeleton-line w-100"></div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <p class="text-center text-body-secondary py-5" data-no-matches hidden>No hikes match these filters. Try another length or a longer trip.</p>
    <div class="empty-state text-center py-5" data-empty hidden>
      <div class="display-6 mb-3" aria-hidden="true">🧭</div>
      <p class="lead mb-2">No day hikes by train with a way back the same evening were found for this search.</p>
      <p class="text-body-secondary mb-0">Try the other weekend day, or start from a nearby city.</p>
    </div>
    <div class="alert alert-warning mt-4 mb-0" role="status" data-notices hidden></div>
    <% min_km = TrailsService::MIN_DISTANCE_METERS / 1000 %>
    <% min_miles = (TrailsService::MIN_DISTANCE_METERS / OverpassService::METERS_PER_MILE).round %>
    <p class="small text-body-secondary mt-4 mb-0">
      Trips leave at 8 AM on the day you choose from the major train stations near your starting point, each with
      lines the others don't have, and getting to the station is up to you. They follow the timetables Transitous has
      for the region: commuter rail, Amtrak, or other trains, and a walk rather than a short ride where it's about as
      quick. Buses are only for where no train goes. Each hike shows from the station that gets there soonest.
      Hikes are near stations at least <%= min_km %> km (<%= min_miles %> miles) out, and hikes the subway or light
      rail reaches are left out, since you likely know them already. Every hike shown leaves time to hike it all by
      sunset, with twilight left for the walk to the station, and has a way back to its station by 11 PM. Once
      each card's trips are looked up, the way back rides the same trains back, home soonest after the hike, then the
      first after sunset, for hiking until then, or the last trip back where that leaves first; hikes the trips leave
      too little time for are taken off the page. The round trip adds the rides there and back. Hikes with the grandest view
      or waterfall come first: views count for how far a route climbs and how far its high point stands above the
      land around it, and more with a mapped viewpoint or a named or famous summit, while waterfalls count more with
      a name, a Wikipedia article, or height. The best counts in full and the next only half, so one grand view
      outranks many small ones; ties go to day-hike length, paving, and the round trip.
      Lengths are approximate, calculated from OpenStreetMap geometry, and climbs from elevation data. Directions lead
      to where the train reaches each route soonest, not to a verified trailhead or public access point. Photos show
      only nature: the nearest park or natural area and photos taken along the route, not necessarily of it.
    </p>
  <% end %>
  <p class="small text-body-secondary mt-2 mb-0">
    From each of up to <%= TransitousService::MAX_STATIONS %> major stations within
    <%= TransitousService::STATION_RADII.first / 1000 %> km, each search looks for mapped hiking routes within a
    <%= TransitAccess::MAX_WALK_MINUTES %>-minute walk of the stations its trains reach within
    <%= duration_label(TransitousService::STATION_MINUTES * 60) %>, then checks trips for up to
    <%= OverpassService::MAX_TRANSIT_ROUTES %> hikes of <%= OverpassService::MIN_LENGTH_MILES.round %> to
    <%= OverpassService::MAX_LENGTH_MILES %> miles that aren't mostly paved. Searches from a station are shared with
    everyone who searches near it.
  </p>
<% end %>
