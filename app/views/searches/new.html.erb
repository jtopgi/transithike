<section class="hero text-white">
  <div class="container hero-body">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-xl-7">
        <div class="text-center">
          <p class="hero-kicker text-uppercase fw-semibold small mb-2">Car-free hiking</p>
          <h1 class="display-5 fw-bold mb-3">Find hikes you can reach by public transit</h1>
          <p class="lead mb-4">
            Tell us where you're starting. TransitHike finds mapped hiking routes nearby and how long it takes
            to reach each one by bus, train, or on foot.
          </p>
        </div>
        <div class="card search-card border-0 shadow-lg">
          <div class="card-body p-4">
            <%= render "search_box", origin: @origin %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="container py-5">
  <h2 class="visually-hidden">How it works</h2>
  <div class="row g-4">
    <div class="col-md-4">
      <div class="step-icon" aria-hidden="true">📍</div>
      <h3 class="h5">Pick a starting point</h3>
      <p class="text-body-secondary mb-0">Start typing a city, neighborhood, station, or address, or use your location.</p>
    </div>
    <div class="col-md-4">
      <div class="step-icon" aria-hidden="true">🚌</div>
      <h3 class="h5">See how to get there</h3>
      <p class="text-body-secondary mb-0">Travel times come from real transit timetables, for leaving now or the next morning.</p>
    </div>
    <div class="col-md-4">
      <div class="step-icon" aria-hidden="true">🗺️</div>
      <h3 class="h5">Compare and go</h3>
      <p class="text-body-secondary mb-0">Sort by travel time, distance, or hike length, preview each route, then open directions.</p>
    </div>
  </div>
</section>
