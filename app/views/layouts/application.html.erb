<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= content_for?(:title) ? safe_join([yield(:title), " · TransitHike"]) : "TransitHike · Weekend hikes you can reach by transit" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <% description = content_for?(:description) ? yield(:description) : "Weekend day hikes you can reach by transit from the city, with a way back the same evening."
       page_title = content_for?(:title) ? yield(:title) : "Weekend hikes you can reach by transit"
       page_url = content_for?(:canonical) ? yield(:canonical) : request.base_url + request.path %>
    <meta name="description" content="<%= description %>">
    <% if content_for?(:robots) %>
      <meta name="robots" content="<%= yield(:robots) %>">
    <% else %>
      <link rel="canonical" href="<%= page_url %>">
    <% end %>
    <%# Shared links show a preview with the page's title, summary, and a photo. %>
    <meta property="og:site_name" content="TransitHike">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:url" content="<%= page_url %>">
    <meta property="og:image" content="<%= content_for?(:og_image) ? yield(:og_image) : "#{request.base_url}/og-image.png" %>">
    <meta name="twitter:card" content="summary_large_image">
    <%# Proof of ownership for Google Search Console and Bing Webmaster Tools, when set. %>
    <% if ENV["GOOGLE_SITE_VERIFICATION"].present? %>
      <meta name="google-site-verification" content="<%= ENV["GOOGLE_SITE_VERIFICATION"] %>">
    <% end %>
    <% if ENV["BING_SITE_VERIFICATION"].present? %>
      <meta name="msvalidate.01" content="<%= ENV["BING_SITE_VERIFICATION"] %>">
    <% end %>
    <%= yield :structured_data %>
    <meta name="theme-color" content="#14532d">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application" %>
    <%= javascript_include_tag "application", defer: true %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-dark site-nav">
      <div class="container">
        <%= link_to root_path, class: "navbar-brand fw-bold d-flex align-items-center gap-2" do %>
          <span class="brand-mark" aria-hidden="true">🥾</span> TransitHike
          <span class="badge rounded-pill text-bg-light text-success fw-semibold">Beta</span>
        <% end %>
        <div class="d-flex gap-3">
          <%= link_to "Guides", guides_path, class: "nav-link link-light link-opacity-75 link-opacity-100-hover small" %>
          <%= link_to "Send feedback", "https://github.com/jtopgi/transithike/issues/new?labels=feedback&title=Feedback%3A+",
                class: "nav-link link-light link-opacity-75 link-opacity-100-hover small" %>
          <%= link_to "GitHub", "https://github.com/jtopgi/transithike",
                class: "nav-link link-light link-opacity-75 link-opacity-100-hover small d-none d-sm-block" %>
        </div>
      </div>
    </nav>

    <main class="flex-grow-1">
      <%= yield %>
    </main>

    <footer class="site-footer py-4 mt-5">
      <div class="container small">
        <p class="mb-1">
          Transit travel times by <%= link_to "Transitous", "https://transitous.org" %>
          (<%= link_to "data sources", TransitousService::SOURCES_URL %>). Place search by
          <%= link_to "Photon", "https://photon.komoot.io" %>. Hiking routes and maps ©
          <%= link_to "OpenStreetMap contributors", "https://www.openstreetmap.org/copyright" %>. Elevation from
          <%= link_to "Terrain Tiles", ElevationService::ATTRIBUTION_URL %> (USGS 3DEP, SRTM, GMTED2010, and other
          sources). Traffic noise in the US from the U.S. DOT's
          <%= link_to "National Transportation Noise Map", NoiseService::ATTRIBUTION_URL %>. Photos from
          <%= link_to "Wikipedia", "https://www.wikipedia.org" %> and
          <%= link_to "Wikimedia Commons", "https://commons.wikimedia.org" %>, credited on each photo.
        </p>
        <p class="mb-0">
          Routes start at their first mapped point, which may not be an official trailhead, so check the route and
          local conditions before you go. Visits are counted without cookies: the pages seen, the site people came
          from, their kind of device, and their country and city, but never their IP address.
          <%= link_to "Open source", "https://github.com/jtopgi/transithike" %> under the MIT license.
        </p>
      </div>
    </footer>
  </body>
</html>
