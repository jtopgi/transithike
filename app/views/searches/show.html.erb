<% label = coordinates && @origin == SearchesController::CURRENT_LOCATION ? "your location" : @origin %>
<% content_for :title, @error ? "Day hikes by train" : "Day hikes by train from #{label}" %>
<section class="results-hero text-white">
  <div class="container py-4">
    <div class="row g-4 align-items-center">
      <div class="col-lg-6">
        <% if @error %>
          <h1 class="h2 fw-bold mb-0">Day hikes by train</h1>
        <% else %>
          <h1 class="h2 fw-bold mb-1" data-heading>Day hikes by train from <%= label %></h1>
          <p class="mb-0 results-subtitle" data-departure>
            Weekend day trips by train, with a way back the same evening.
          </p>
        <% end %>
      </div>
      <div class="col-lg-6">
        <div class="card search-card border-0 shadow">
          <div class="card-body p-3">
            <%= render "search_box", origin: @origin %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<% unless @error
     stream_url = search_stream_path({ origin: @origin, lat: coordinates&.first, lon: coordinates&.last,
       day: requested_day, tz: requested_time_zone }.compact)
   end %>
<%= tag.div class: "container py-4", data: { stream_url: stream_url } do %>
  <% if @error %>
    <div class="alert alert-danger" role="alert"><%= @error %></div>
  <% else %>
    <noscript><div class="alert alert-warning">TransitHike needs JavaScript to find hikes.</div></noscript>
    <div class="alert alert-danger" role="alert" data-failure hidden></div>
    <div class="search-progress mb-4" data-progress role="status" aria-live="polite">
      <span class="spinner-border spinner-border-sm text-success" aria-hidden="true"></span>
      <span data-progress-text>Finding the stations trains reach and the hikes near them…</span>
    </div>
    <div class="results-toolbar d-flex flex-wrap align-items-center gap-3 mb-4" data-results-toolbar hidden>
      <div class="d-flex align-items-center gap-2">
        <label for="sort" class="form-label small fw-semibold mb-0">Sort by</label>
        <select id="sort" class="form-select form-select-sm w-auto" data-sort>
          <option value="recommended">Recommended</option>
          <option value="travel">Least travel</option>
          <option value="stay">Most time there</option>
          <option value="distance">Closest</option>
          <option value="popular">Most popular</option>
          <option value="scenic">Most scenic</option>
          <option value="length-asc">Shortest hike</option>
          <option value="length-desc">Longest hike</option>
        </select>
      </div>
      <div class="d-flex align-items-center gap-2">
        <label for="trip" class="form-label small fw-semibold mb-0">Round trip</label>
        <select id="trip" class="form-select form-select-sm w-auto" data-max-trip>
          <option value="">Any travel time</option>
          <option value="180">Up to 3 hours</option>
          <option value="240">Up to 4 hours</option>
          <option value="300">Up to 5 hours</option>
          <option value="360">Up to 6 hours</option>
        </select>
      </div>
      <div class="btn-group btn-group-sm" role="group" aria-label="Hike length" data-length-filter>
        <% { "any" => "Any length", "short" => "Under 3 mi", "medium" => "3–6 mi", "long" => "Over 6 mi" }.each do |value, text| %>
          <input type="radio" class="btn-check" name="length" id="length-<%= value %>" value="<%= value %>" <%= "checked" if value == "any" %>>
          <label class="btn btn-outline-success" for="length-<%= value %>"><%= text %></label>
        <% end %>
      </div>
      <span class="small text-body-secondary ms-lg-auto" data-results-count aria-live="polite"></span>
    </div>
    <div class="row row-cols-1 row-cols-md-2 g-4" data-trails>
      <% 2.times do %>
        <div class="col" data-skeleton aria-hidden="true">
          <div class="card trail-card trail-skeleton h-100 border-0 shadow-sm">
            <div class="trail-media"></div>
            <div class="card-body p-4">
              <div class="skeleton-line w-75"></div>
              <div class="skeleton-line w-50"></div>
              <div class="skeleton-line w-100"></div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <p class="text-center text-body-secondary py-5" data-no-matches hidden>No hikes match these filters. Try another length or a longer trip.</p>
    <div class="empty-state text-center py-5" data-empty hidden>
      <div class="display-6 mb-3" aria-hidden="true">🧭</div>
      <p class="lead mb-2">No day hikes by train with a way back the same evening were found for this search.</p>
      <p class="text-body-secondary mb-0">Try the other weekend day, or start from a station or a nearby neighborhood.</p>
    </div>
    <div class="alert alert-warning mt-4 mb-0" role="status" data-notices hidden></div>
    <% min_km = TrailsService::MIN_DISTANCE_METERS / 1000 %>
    <% min_miles = (TrailsService::MIN_DISTANCE_METERS / OverpassService::METERS_PER_MILE).round %>
    <p class="small text-body-secondary mt-4 mb-0">
      Trips leave at 8 AM on the day you choose, from the timetables Transitous has for the region: the subway or bus
      to the station if you need them, then commuter rail, Amtrak, or other trains. Hikes are near stations
      at least <%= min_km %> km (<%= min_miles %> miles) away, and hikes the subway or light rail reaches are left out,
      since you likely know them already. Every hike shown has a way back by 11 PM that leaves time to hike it. Once
      each card's trips are looked up, the way back rides the same trains back, home soonest after the hike, and the
      last trip back is the last that way; the round trip adds the rides there and back. Recommended hikes are unpaved
      and of day-hike length, pass waterfalls, summits, or viewpoints, are in well-known parks, and aren't too long a
      trip there and back. Popularity comes from
      Wikipedia page views of the nearest park or natural area, not of the route itself. Lengths are approximate,
      calculated from OpenStreetMap geometry. Directions lead to where the train reaches each route soonest, not to a
      verified trailhead or public access point. Photos show a nearby park or natural area, not necessarily the route.
    </p>
  <% end %>
  <p class="small text-body-secondary mt-2 mb-0">
    Each search looks for mapped hiking routes within a <%= TransitAccess::MAX_WALK_MINUTES %>-minute walk of the
    stations trains reach within <%= TransitousService::STATION_MINUTES / 60 %> hours, then checks trips for up to
    <%= OverpassService::MAX_TRANSIT_ROUTES %> hikes of <%= OverpassService::MIN_LENGTH_MILES.round %> to
    <%= OverpassService::MAX_LENGTH_MILES %> miles that aren't mostly paved.
  </p>
<% end %>
