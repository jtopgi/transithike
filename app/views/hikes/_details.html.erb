<%# A hike in detail: its route and photos, and the timetables of the trips there that leave time to hike all of it,
    and of the trips back. Shared by search results' detail pages and the cities' guides. %>
<% last = ways[:last]
   back_trips = Array(ways[:trips])
   finish_note = trail.finish ? " from the far end of the route" : "" %>
<div class="container py-4">
  <div class="row g-4">
    <div class="col-lg-7">
      <div class="hike-map rounded-3 shadow-sm mb-3" data-hike-map role="img" aria-label="Map of <%= trail.name %>"
           data-path="<%= trail.path.to_json %>" data-start="<%= [trail.latitude, trail.longitude].to_json %>"
           <% if trail.finish %>data-finish="<%= trail.finish.to_json %>"<% end %>></div>
      <%= render "searches/chips", trail: trail %>
      <dl class="trail-stats hike-facts">
        <div>
          <dt><span aria-hidden="true">🥾</span> Hike</dt>
          <dd>
            ≈ <%= number_with_precision(TrailsService.hike_miles(trail), precision: 1) %> mi
            <small class="trail-transfers"><%= hike_plan_label(trail) %>, about <%= duration_label(TrailsService.hike_hours(trail).hours, approximate: true) %></small>
          </dd>
        </div>
        <% if trail.terrain %>
          <div>
            <dt><span aria-hidden="true">⛰️</span> Climb</dt>
            <dd><%= climb_label(trail) %></dd>
          </div>
        <% end %>
        <% if there %>
          <div>
            <dt><span aria-hidden="true">🚆</span> Each way</dt>
            <dd>
              <%= ride_label(there) %>
              <small class="trail-transfers"><%= transfers_label([Array(there[:legs]).size - 1, 0].max) if there[:legs].present? %></small>
            </dd>
          </div>
        <% end %>
        <% if last %>
          <div>
            <dt><span aria-hidden="true">↩️</span> Last trip back</dt>
            <dd>
              <%= trip_clock(last[:departure], zone) %>
              <small class="trail-transfers"><%= "from #{boarding_stop(last)}" if boarding_stop(last) %></small>
            </dd>
          </div>
        <% end %>
      </dl>
      <% if there && last %>
        <p class="mb-2 hike-intro">
          Taking the first trip there, you arrive at <strong><%= trip_clock(there[:arrival], zone) %></strong> and have up to
          <strong><%= duration_label(Time.iso8601(last[:departure]) - Time.iso8601(there[:arrival])) %></strong> until the last
          trip back<%= finish_note %>, for a hike of about <%= duration_label(TrailsService.hike_hours(trail).hours, approximate: true) %>.
        </p>
      <% end %>
      <p class="text-body-secondary small"><%= trail.summary %></p>
      <div class="d-flex flex-wrap gap-2 mb-2">
        <%= link_to trail.finish ? "🧭 Directions there" : "🧭 Directions", directions_url(trail), class: "btn btn-success btn-sm",
              target: "_blank", rel: "noopener" %>
        <% if trail.finish %>
          <%= link_to "🧭 Directions back", directions_back_url(trail, place), class: "btn btn-success btn-sm", target: "_blank",
                rel: "noopener" %>
        <% end %>
        <%= link_to "View on OpenStreetMap", "https://www.openstreetmap.org/relation/#{trail.osm_id}",
              class: "btn btn-outline-secondary btn-sm", target: "_blank", rel: "noopener" %>
      </div>
    </div>
    <div class="col-lg-5">
      <%= render "hikes/photos", photos: photos %>
    </div>
  </div>

  <section class="mt-4" aria-labelledby="there-heading">
    <h2 class="h4" id="there-heading">Getting there</h2>
    <% if departures.any? %>
      <p class="text-body-secondary">
        Trips from <%= origin_name %> that arrive in time to hike all
        <%= number_with_precision(TrailsService.hike_miles(trail), precision: 1) %> miles before the last trip back.
        <% if there && (walk = walk_after(there)) %>
          From the last stop, it's about a <%= walk %>-minute walk to where the route starts.
        <% end %>
      </p>
      <%= render "hikes/timetable", trips: departures, zone: zone, arrive_label: "Arrive", mark_last: false,
            caption: "Trips there from #{origin_name}" %>
    <% else %>
      <p class="text-body-secondary">We couldn't find the trips there just now. Check the directions before you go.</p>
    <% end %>
  </section>

  <section class="mt-4" aria-labelledby="back-heading">
    <h2 class="h4" id="back-heading">Coming back</h2>
    <% if back_trips.any? %>
      <p class="text-body-secondary">
        Trips home<%= finish_note %>, from the first after the hike, if you take the first trip there, until the last one
        that gets you home by <%= return_by.strftime("%-I %p") %>.
        <% if ways[:same_way] == false %>
          The same way back doesn't run after the hike, or takes much longer, so these go another way.
        <% end %>
      </p>
      <%= render "hikes/timetable", trips: back_trips, zone: zone, arrive_label: "Home", mark_last: true,
            caption: "Trips back to #{origin_name}" %>
    <% else %>
      <p class="text-body-secondary">We couldn't find the trips back just now. Check the directions before you go.</p>
    <% end %>
  </section>

  <p class="small text-body-secondary mt-4 mb-0">
    Times are for <%= leave.strftime("%A, %B %-d") %>, from Transitous; check them before you go. Hikes are timed at
    about 2 miles an hour with breaks, and the last trip back leaves at least half an hour after. Routes start at their
    first mapped point, which may not be an official trailhead.
  </p>
</div>
