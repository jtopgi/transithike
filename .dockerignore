# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git and CI files.
/.git/
/.gitignore
/.github

# Ignore bundler config.
/.bundle

# Ignore all environment and key files.
/.env*
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles, but keep the directories.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
!/tmp/pids/
/tmp/pids/*
!/tmp/pids/.keep

# Ignore uploaded files in development.
/storage/*
!/storage/.keep

# Ignore dependencies and built assets; the image builds its own.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore Docker-related files.
/.dockerignore
/Dockerfile*
