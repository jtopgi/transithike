<%# A hike in detail: its route and photos, and the timetables of the trips there that leave time to hike all of it,
    and of the trips back. Shared by search results' detail pages and the cities' guides. %>
<% # Where the sun doesn't rise, Daylight's sunset is before the day starts, and none is shown.
   sunset = trail.sunset if trail.sunset && trail.sunset > leave
   # Trips back only until the first after sunset, when sunset is the hike's deadline. Guides built before
   # trips back stopped there have them all.
   ways = TripPlans.until_sunset(ways, sunset)
   last, dusk = ways.values_at(:last, :after_sunset)
   back_trips = Array(ways[:trips])
   last_time = Time.iso8601(last[:departure]) if last
   dark = TripPlans.sunset_first?(sunset, last_time)
   deadline = dark ? sunset : last_time
   # The trip back to show: the first after sunset, for hiking until then, or the last one when it's the deadline.
   latest = dusk || last
   latest_label = dusk && dusk[:departure] != last&.dig(:departure) ? "After sunset" : "Last trip back"
   finish_note = trail.finish ? " from the far end of the route" : "" %>
<div class="container py-4">
  <div class="row g-4">
    <div class="col-lg-7">
      <div class="hike-map rounded-3 shadow-sm mb-3" data-hike-map role="img" aria-label="Map of <%= trail.name %>"
           data-path="<%= trail.path.to_json %>" data-start="<%= [trail.latitude, trail.longitude].to_json %>"
           <% if trail.finish %>data-finish="<%= trail.finish.to_json %>"<% end %>></div>
      <% if trail.location %>
        <p class="trail-location text-body-secondary mb-2"><span aria-hidden="true">📍</span> <%= trail.location %></p>
      <% end %>
      <%= render "searches/chips", trail: trail %>
      <dl class="trail-stats hike-facts">
        <div>
          <dt><span aria-hidden="true">🥾</span> Hike</dt>
          <dd>
            ≈ <%= number_with_precision(TrailsService.hike_miles(trail), precision: 1) %> mi
            <small class="trail-transfers"><%= hike_plan_label(trail) %>, about <%= duration_label(TrailsService.hike_hours(trail).hours, approximate: true) %></small>
          </dd>
        </div>
        <% if trail.terrain %>
          <div>
            <dt><span aria-hidden="true">⛰️</span> Climb</dt>
            <dd><%= climb_label(trail) %></dd>
          </div>
        <% end %>
        <% if there %>
          <div>
            <dt><span aria-hidden="true">🚆</span> Each way</dt>
            <dd>
              <%= ride_label(there) %>
              <small class="trail-transfers"><%= transfers_label([Array(there[:legs]).size - 1, 0].max) if there[:legs].present? %></small>
            </dd>
          </div>
        <% end %>
        <% if sunset %>
          <div>
            <dt><span aria-hidden="true">🌇</span> Sunset</dt>
            <dd>
              <%= sunset.in_time_zone(zone).strftime("%-I:%M %p") %>
              <small class="trail-transfers">hike done by then</small>
            </dd>
          </div>
        <% end %>
        <% if latest %>
          <div>
            <dt><span aria-hidden="true">↩️</span> <%= latest_label %></dt>
            <dd>
              <%= trip_clock(latest[:departure], zone) %>
              <small class="trail-transfers"><%= "from #{boarding_stop(latest)}" if boarding_stop(latest) %></small>
            </dd>
          </div>
        <% end %>
      </dl>
      <% if there && deadline %>
        <p class="mb-2 hike-intro">
          Taking the first trip there, you arrive at <strong><%= trip_clock(there[:arrival], zone) %></strong> and have up to
          <strong><%= duration_label([deadline - Time.iso8601(there[:arrival]), 0].max) %></strong> until
          <%= dark ? "sunset" : "the last trip back#{finish_note}" %>, for a hike of about
          <%= duration_label(TrailsService.hike_hours(trail).hours, approximate: true) %>.
        </p>
      <% end %>
      <p class="text-body-secondary small"><%= trail.summary %></p>
      <div class="d-flex flex-wrap gap-2 mb-2">
        <%= link_to trail.finish ? "🧭 Directions there" : "🧭 Directions", directions_url(trail), class: "btn btn-success btn-sm",
              target: "_blank", rel: "noopener" %>
        <% if trail.finish %>
          <%= link_to "🧭 Directions back", directions_back_url(trail, place), class: "btn btn-success btn-sm", target: "_blank",
                rel: "noopener" %>
        <% end %>
        <%= link_to "View on OpenStreetMap", "https://www.openstreetmap.org/relation/#{trail.osm_id}",
              class: "btn btn-outline-secondary btn-sm", target: "_blank", rel: "noopener" %>
      </div>
    </div>
    <div class="col-lg-5">
      <%= render "hikes/photos", photos: photos %>
    </div>
  </div>

  <section class="mt-4" aria-labelledby="there-heading">
    <h2 class="h4" id="there-heading">Getting there</h2>
    <% if departures.any? %>
      <p class="text-body-secondary">
        Trips from <%= origin_name %> that arrive in time to hike all
        <%= number_with_precision(TrailsService.hike_miles(trail), precision: 1) %> miles by sunset and before the last trip back.
        <% if there && (walk = walk_after(there)) %>
          From the last stop, it's about a <%= walk %>-minute walk to where the route starts.
        <% end %>
      </p>
      <%= render "hikes/timetable", trips: departures, zone: zone, arrive_label: "Arrive", last_label: nil,
            caption: "Trips there from #{origin_name}" %>
    <% elsif there %>
      <p class="text-body-secondary">
        No trip from <%= origin_name %> arrives in time to hike all
        <%= number_with_precision(TrailsService.hike_miles(trail), precision: 1) %> miles by sunset and before the last trip
        back on <%= leave.strftime("%A, %B %-d") %>.
      </p>
    <% else %>
      <p class="text-body-secondary">We couldn't find the trips there just now. Check the directions before you go.</p>
    <% end %>
  </section>

  <section class="mt-4" aria-labelledby="back-heading">
    <h2 class="h4" id="back-heading">Coming back</h2>
    <% if back_trips.any? %>
      <p class="text-body-secondary">
        Trips home<%= finish_note %>, from the first after the hike, if you take the first trip there, until
        <% if dusk %>
          the first after sunset, for hiking until then.
        <% else %>
          the last one that gets you home by <%= return_by.strftime("%-I %p") %>.
        <% end %>
        <% if ways[:same_way] == false %>
          The same way back doesn't run after the hike, or takes much longer, so these go another way.
        <% end %>
      </p>
      <%= render "hikes/timetable", trips: back_trips, zone: zone, arrive_label: "Home",
            last_label: latest_label == "After sunset" ? "After sunset" : "Last", caption: "Trips back to #{origin_name}" %>
    <% else %>
      <p class="text-body-secondary">We couldn't find the trips back just now. Check the directions before you go.</p>
    <% end %>
  </section>

  <p class="small text-body-secondary mt-4 mb-0">
    Times are for <%= leave.strftime("%A, %B %-d") %>, from Transitous; check them before you go. Hikes are timed at
    about 2 miles an hour with breaks, to be done by sunset, with twilight left for the walk to the station, and at
    least half an hour before the last trip back. Routes start at their first mapped point, which may not be an official
    trailhead.
  </p>
</div>
