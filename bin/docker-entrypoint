#!/bin/bash -e
# Prepares the database, when there is one, before the server starts: creates it
# and runs migrations. Searches work without it, only without keeping what they
# find, so a database that can't be reached doesn't keep the server from starting.
if [ -n "${DATABASE_URL:-}" ] && [ "${*}" = "bundle exec puma -C config/puma.rb" ]; then
  ./bin/rails db:prepare || echo "The database couldn't be prepared, so the server starts without it." >&2
fi

exec "$@"
