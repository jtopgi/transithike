<div class="col" data-trail data-osm-id="<%= trail.osm_id %>" data-score="<%= trail.score %>"
     data-scenic="<%= TrailsService.scenic(trail) %>" data-travel="<%= TrailsService.round_trip_seconds(trail).round %>"
     data-length="<%= TrailsService.hike_miles(trail).round(2) %>"
     data-plan="<%= trail.plan %>" data-hike="<%= (TrailsService.hike_hours(trail) * 3600).round %>"
     <% if trail.sunset %>data-sunset="<%= trail.sunset.utc.iso8601 %>"<% end %>
     data-required="<%= (TrailsService.required_hours(trail) * 3600).round %>">
  <article class="card trail-card h-100 border-0 shadow-sm">
    <div class="trail-media">
      <div class="trail-map" role="img" aria-label="Map of <%= trail.name %>"
           data-path="<%= trail.path.to_json %>" data-start="<%= [trail.latitude, trail.longitude].to_json %>"
           <% if trail.finish %>data-finish="<%= trail.finish.to_json %>"<% end %>></div>
      <a class="trail-photo" data-photos-url="<%= photos_path(points: photo_points(trail)) %>" hidden
         target="_blank" rel="noopener">
        <img alt="" decoding="async">
        <span class="trail-photo-caption"></span>
      </a>
    </div>
    <div class="trail-gallery" role="group" aria-label="Photos near <%= trail.name %>" data-gallery hidden></div>
    <div class="card-body d-flex flex-column p-3 p-sm-4">
      <h2 class="card-title h5 mb-1"><%= trail.name %></h2>
      <%# Where the route is shows once its trips are looked up, in space kept for it. %>
      <p class="trail-location small text-body-secondary mb-<%= trail.station ? 1 : 3 %><%= " invisible" unless trail.location %>" data-location>
        <span aria-hidden="true">📍</span> <span data-location-text><%= trail.location %></span>
      </p>
      <% if trail.station %>
        <p class="trail-station small mb-3"><span aria-hidden="true">🚉</span> Trains from <strong><%= trail.station.name %></strong></p>
      <% end %>
      <div data-chips><%= render "searches/chips", trail: trail %></div>
      <dl class="trail-stats">
        <div>
          <dt><span aria-hidden="true">🕒</span> Round trip</dt>
          <dd>
            <%# Twice the trip there, waiting for the train included, until the planned trips there and back show. %>
            <span data-travel-time>≈ <%= duration_label(TrailsService.round_trip_seconds(trail), approximate: true) %></span>
            <small class="trail-transfers" data-travel-detail>
              ≈ <%= duration_label(trail.duration, approximate: true) %> each way · <%= transfers_label(trail.transfers) %>
            </small>
          </dd>
        </div>
        <div>
          <dt><span aria-hidden="true">🥾</span> Hike</dt>
          <dd>
            ≈ <%= number_with_precision(TrailsService.hike_miles(trail), precision: 1) %> mi
            <small class="trail-transfers"><%= hike_plan_label(trail) %></small>
          </dd>
        </div>
        <%# How far it climbs, once the search has looked up its terrain. %>
        <div data-climb-stat <%= "hidden" unless trail.terrain %>>
          <dt><span aria-hidden="true">⛰️</span> Climb</dt>
          <dd data-climb><%= climb_label(trail) %></dd>
        </div>
        <%= render "searches/noise_stat", trail: trail %>
      </dl>
      <%# The last trip back leaves before dark, and the hike is done by sunset, before it. %>
      <p class="trail-return">
        <span data-return>
          <% if trail.last_return %>
            <span aria-hidden="true">↩️</span> Last trip back<%= " from the far end" if trail.finish %>
            <strong data-last-return><%= clock(trail.last_return, result) %></strong>
          <% else %>
            <span aria-hidden="true">⚠️</span> We couldn't check the way back. Check it before you go.
          <% end %>
        </span>
        <span class="text-body-secondary" data-stay-label><%= "· up to #{stay_label(trail)} there" if trail.last_return %></span>
      </p>
      <div class="trail-trip small" data-trip-url="<%= trip_lookup_path(trail, result) %>" aria-live="polite" hidden></div>
      <p class="card-text trail-summary text-body-secondary flex-grow-1"><%= trail.summary %></p>
      <p class="trail-photo-credit small text-body-secondary" hidden></p>
      <div class="d-flex flex-wrap gap-2">
        <%= link_to trail.finish ? "🧭 Directions there" : "🧭 Directions", directions_url(trail), class: "btn btn-success btn-sm",
              target: "_blank", rel: "noopener", aria: { label: "Transit directions to #{trail.name}" } %>
        <% if trail.finish %>
          <%= link_to "🧭 Directions back", directions_back_url(trail, result.place), class: "btn btn-success btn-sm",
                target: "_blank", rel: "noopener", aria: { label: "Transit directions back from the end of #{trail.name}" } %>
        <% end %>
        <%# Shorter on phones, so the buttons fit on a line. %>
        <%= link_to hike_details_path(trail, result), class: "btn btn-outline-success btn-sm",
              aria: { label: "Details and timetables for #{trail.name}" } do %>Details<span class="d-none d-sm-inline"> &amp; timetables</span><% end %>
        <%= link_to "https://www.openstreetmap.org/relation/#{trail.osm_id}", class: "btn btn-outline-secondary btn-sm",
              target: "_blank", rel: "noopener", aria: { label: "#{trail.name} on OpenStreetMap" } do %><span class="d-none d-sm-inline">View on </span>OpenStreetMap<% end %>
      </div>
    </div>
  </article>
</div>
