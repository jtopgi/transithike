<div class="col" data-trail data-rank="<%= trail_counter %>" data-duration="<%= trail.duration.round %>"
     data-length="<%= trail.length.round(2) %>" data-distance="<%= trail.distance.round(2) %>"
     data-popularity="<%= trail.area&.dig(:monthly_views).to_i %>" data-scenic="<%= TrailsService.scenic(trail) %>">
  <article class="card trail-card h-100 border-0 shadow-sm">
    <div class="trail-media">
      <div class="trail-map" role="img" aria-label="Map of <%= trail.name %>"
           data-path="<%= trail.path.to_json %>" data-start="<%= [trail.latitude, trail.longitude].to_json %>"></div>
      <a class="trail-photo" data-photo-url="<%= photo_path(lat: trail.midpoint.first, lon: trail.midpoint.last) %>" hidden
         target="_blank" rel="noopener">
        <img alt="" decoding="async">
        <span class="trail-photo-caption"></span>
      </a>
    </div>
    <div class="card-body d-flex flex-column p-4">
      <h2 class="card-title h5 mb-3"><%= trail.name %></h2>
      <% if (chips = trail_chips(trail)).any? %>
        <ul class="trail-chips" aria-label="Highlights">
          <% chips.each do |icon, label, detail| %>
            <li class="trail-chip" title="<%= detail %>">
              <span aria-hidden="true"><%= icon %></span>
              <span class="trail-chip-label"><%= label %></span>
              <span class="visually-hidden">(<%= detail %>)</span>
            </li>
          <% end %>
        </ul>
      <% end %>
      <dl class="trail-stats">
        <div>
          <dt><span aria-hidden="true">🚌</span> Travel time</dt>
          <dd>
            <%= (trail.duration / 60.0).ceil %> min
            <small class="trail-transfers"><%= transfers_label(trail.transfers) %></small>
          </dd>
        </div>
        <div>
          <dt><span aria-hidden="true">🥾</span> Length</dt>
          <dd>≈ <%= number_with_precision(trail.length, precision: 1) %> mi</dd>
        </div>
        <div>
          <dt><span aria-hidden="true">📍</span> Distance</dt>
          <dd><%= number_with_precision(trail.distance, precision: 1) %> mi</dd>
        </div>
      </dl>
      <p class="card-text trail-summary text-body-secondary flex-grow-1"><%= trail.summary %></p>
      <p class="trail-photo-credit small text-body-secondary" hidden></p>
      <div class="d-flex flex-wrap gap-2">
        <%= link_to "🧭 Directions", directions_url(trail), class: "btn btn-success btn-sm", target: "_blank",
              rel: "noopener", aria: { label: "Transit directions to #{trail.name}" } %>
        <%= link_to "View on OpenStreetMap", "https://www.openstreetmap.org/relation/#{trail.osm_id}",
              class: "btn btn-outline-secondary btn-sm", target: "_blank", rel: "noopener",
              aria: { label: "#{trail.name} on OpenStreetMap" } %>
      </div>
    </div>
  </article>
</div>
