<section class="hero text-white">
  <div class="container hero-body">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-xl-7">
        <div class="text-center">
          <p class="hero-kicker text-uppercase fw-semibold small mb-2">Car-free day trips</p>
          <h1 class="display-5 fw-bold mb-3">Weekend hikes you can reach by train</h1>
          <p class="lead mb-4">
            Tell us where in the city you live and pick Saturday or Sunday. TransitHike finds hiking routes near
            commuter and intercity rail stations, with a train back the same evening.
          </p>
        </div>
        <div class="card search-card border-0 shadow-lg">
          <div class="card-body p-4">
            <%= render "search_box", origin: @origin %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="container py-5">
  <h2 class="visually-hidden">How it works</h2>
  <div class="row g-4">
    <div class="col-md-4">
      <div class="step-icon" aria-hidden="true">📍</div>
      <h3 class="h5">Pick a starting point and day</h3>
      <p class="text-body-secondary mb-0">Type a neighborhood, ZIP code, station, or address, or use your location.</p>
    </div>
    <div class="col-md-4">
      <div class="step-icon" aria-hidden="true">🚆</div>
      <h3 class="h5">Take the train out</h3>
      <p class="text-body-secondary mb-0">Trips come from real weekend timetables, with the last train back that leaves time to hike.</p>
    </div>
    <div class="col-md-4">
      <div class="step-icon" aria-hidden="true">🗺️</div>
      <h3 class="h5">Compare and go</h3>
      <p class="text-body-secondary mb-0">Sort by travel time, time there, or hike length, preview each route, then open directions.</p>
    </div>
  </div>
</section>
