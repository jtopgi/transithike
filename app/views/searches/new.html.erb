<% content_for :structured_data do %>
  <%= structured_data({ "@context" => "https://schema.org", "@type" => "WebApplication", "name" => "TransitHike",
        "url" => root_url, "applicationCategory" => "TravelApplication", "operatingSystem" => "Any",
        "description" => "Weekend day hikes you can reach by transit from the city, with a way back the same evening.",
        "offers" => { "@type" => "Offer", "price" => "0", "priceCurrency" => "USD" } }) %>
<% end %>
<section class="hero text-white">
  <div class="container hero-body">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-xl-7">
        <div class="text-center">
          <p class="hero-kicker text-uppercase fw-semibold small mb-2">Car-free day trips</p>
          <h1 class="display-5 fw-bold mb-3">Weekend hikes you can reach by transit</h1>
          <p class="lead mb-4">
            Tell us where in the city you live and pick Saturday or Sunday. TransitHike finds hiking routes near
            the stops trains, buses, and ferries reach, with a way back the same evening.
          </p>
        </div>
        <div class="card search-card border-0 shadow-lg">
          <div class="card-body p-4">
            <%= render "search_box", origin: @origin %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="container py-5">
  <h2 class="visually-hidden">How it works</h2>
  <div class="row g-4">
    <div class="col-md-4">
      <div class="step-icon" aria-hidden="true">📍</div>
      <h3 class="h5">Pick a starting point and day</h3>
      <p class="text-body-secondary mb-0">Type a neighborhood, ZIP code, station, or address, or use your location.</p>
    </div>
    <div class="col-md-4">
      <div class="step-icon" aria-hidden="true">🚆</div>
      <h3 class="h5">Take transit out</h3>
      <p class="text-body-secondary mb-0">Trips come from real weekend timetables, with several each way, time to hike before sunset, and a way back before dark.</p>
    </div>
    <div class="col-md-4">
      <div class="step-icon" aria-hidden="true">🗺️</div>
      <h3 class="h5">Compare and go</h3>
      <p class="text-body-secondary mb-0">See the most scenic first, narrow them down by round trip and length, preview each route, then open directions.</p>
    </div>
  </div>
</section>

<% if @guides.any? %>
  <section class="container pb-5" aria-labelledby="guides-heading">
    <h2 class="h4" id="guides-heading">Day hikes by transit from</h2>
    <p class="text-body-secondary">Weekly guides to every hike we found from these cities, with timetables there and back.</p>
    <div class="d-flex flex-wrap gap-2">
      <% @guides.each do |page| %>
        <%= link_to page.guide.name, guide_path(page.guide.slug), class: "btn btn-outline-success" %>
      <% end %>
    </div>
  </section>
<% end %>
